---
export const prerender=false;
const folio=String(Astro.params.code||'').toUpperCase();
if(!/^CA-[1-9][0-9]{0,10}$/.test(folio))return Astro.redirect('/');
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#101010"/><title>Control de acceso · {folio}</title></head><body data-folio={folio}>
<header><a href="/">‹ Inicio</a><b>CAZAMI ACCESS</b><button id="exit" hidden>Salir</button></header>
<main><small>CONTROL DE ACCESO · {folio}</small><h1 id="name">Tu fiesta</h1><p id="notice" role="status">Comprobando acceso...</p>
<section id="login" hidden><h2>Autorizar dispositivo</h2><p>Inicia sesión una vez para proteger los pases del evento.</p><form id="auth"><label>Usuario<input name="username" autocomplete="username" required/></label><label>Contraseña<input name="password" type="password" autocomplete="current-password" required/></label><button class="primary">Entrar al evento</button></form></section>
<section id="panel" hidden><div class="stats"><div><strong id="total">0</strong>Autorizados</div><div><strong id="entered">0</strong>Ingresaron</div><div><strong id="remaining">0</strong>Pendientes</div></div><button class="primary scan" id="scan">▣ Escanear QR</button><div class="between"><h2>Lista de invitados</h2><button id="refresh">Actualizar</button></div><input id="search" type="search" placeholder="Buscar invitado o pase"/><div id="list"></div></section></main>
<dialog id="scanner"><div class="between"><h2>Escanear pase</h2><button id="close" aria-label="Cerrar escáner">×</button></div><div id="camera"><video id="video" playsinline muted></video><div class="frame"></div></div><p id="hint" role="status">Coloca el QR en el recuadro.</p><form id="manual"><input id="manualCode" placeholder="Código de pase (opcional)"/><button>Validar</button></form><div id="result" hidden><h2 id="title"></h2><strong id="count"></strong><p id="family"></p><p id="detail"></p><button id="register" class="primary" hidden>Registrar entrada</button><button id="next" class="primary" hidden>Registrar siguiente entrada</button></div></dialog>
<script>import '../../scripts/event-access.ts';</script>
<style>*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:#101010;color:#fafafa;font-family:system-ui,sans-serif;min-height:100dvh}header{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:16px;border-bottom:1px solid #333;font-size:13px}a{color:#ddd;text-decoration:none}main{max-width:640px;margin:auto;padding:24px 16px 60px}small,p{color:#bcbcbc}h1{font-size:32px;margin:8px 0}h2{font-size:18px}button,input{font:inherit;border:1px solid #444;border-radius:10px;padding:12px;background:#222;color:white;min-height:44px}button{cursor:pointer}button:disabled{opacity:.5}input{width:100%;min-width:0}label,form{display:grid;gap:10px}.primary{background:white;color:#111;font-weight:800;width:100%;min-height:52px;border:0}.scan{margin:18px 0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stats div{display:grid;text-align:center;gap:6px;padding:15px 5px;border:1px solid #333;border-radius:12px;font-size:11px;background:#191919}.stats strong{font-size:27px}.between{display:flex;align-items:center;justify-content:space-between;gap:10px}.guest{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #333;padding:16px 2px;gap:8px}.guest small{display:block;margin-top:4px}.state{font-size:12px;color:#bbb;text-align:right}.done{color:#66da98}dialog{width:min(94vw,480px);max-height:94dvh;overflow:auto;background:#151515;color:white;border:1px solid #444;border-radius:20px;padding:18px}dialog::backdrop{background:#000c}#camera{position:relative;aspect-ratio:1;background:#252525;border-radius:14px;overflow:hidden;margin-top:12px}video{width:100%;height:100%;object-fit:cover}.frame{position:absolute;inset:17%;border:2px solid white;border-radius:14px;box-shadow:0 0 0 200px #0003;pointer-events:none}#manual{grid-template-columns:1fr auto}#result{text-align:center;border-radius:16px;padding:18px 14px;margin-top:12px;background:#292929}#result.allowed,#result.registered{background:#125e39}#result.denied,#result.used{background:#6c2222}#count{display:block;font-size:36px}#result p{color:white}#login{padding:20px;background:#191919;border-radius:14px;border:1px solid #333}</style></body></html>