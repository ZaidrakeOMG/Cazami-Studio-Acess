---
export const prerender=false;
const folio=String(Astro.params.code||'').toUpperCase();
if(!/^CA-[1-9][0-9]{0,10}$/.test(folio))return Astro.redirect('/');
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#101010"/><title>Control de acceso · {folio}</title></head><body data-folio={folio}>
<header><a class="back" href="/">‹ Inicio</a><div class="brand"><span>CZ</span><b>CAZAMI ACCESS</b></div><button id="exit" hidden>Salir</button></header>
<main><div class="event-heading"><small>CONTROL DE ACCESO <span class="folio">{folio}</span></small><h1 id="name">Tu fiesta</h1><p id="notice" role="status">Comprobando acceso...</p></div>
<section id="login" hidden><div class="lockmark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="28" height="28"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg></div><h2>Autoriza este dispositivo</h2><p>Introduce la clave de acceso de esta fiesta una sola vez. No necesitas correo ni cuenta de administrador.</p><form id="auth"><label>Clave de acceso<input name="code" type="password" autocomplete="off" autocapitalize="characters" maxlength="20" placeholder="Clave de la fiesta" required/></label><button class="primary">Entrar al evento</button></form><small>Solicita la clave al responsable del evento.</small></section>
<section id="panel" hidden><div class="stats"><div><strong id="total">0</strong>Autorizados</div><div><strong id="entered">0</strong>Ingresaron</div><div><strong id="remaining">0</strong>Pendientes</div></div><div class="workspace"><section class="scan-card"><div class="scan-icon"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" width="36" height="36"><path d="M4 12V4h8m8 0h8v8m0 8v8h-8m-8 0H4v-8M4 16h24"/><path d="M10 10h3v3h-3zm9 9h3v3h-3z"/></svg></div><h2>Control de entradas</h2><p>Escanea un pase y registra a tus invitados en segundos.</p><button class="primary scan" id="scan">Escanear QR <span>›</span></button></section><section class="guest-card"><div class="between"><div><small>REGISTRO DE ASISTENCIA</small><h2>Lista de invitados</h2></div><button id="refresh" aria-label="Actualizar lista">↻</button></div><input id="search" type="search" placeholder="Buscar invitado o pase" aria-label="Buscar invitado"/><div id="list"></div></section></div></section></main>
<dialog id="scanner"><div class="between"><h2>Escanear pase</h2><button id="close" aria-label="Cerrar escáner">×</button></div><div id="camera"><video id="video" playsinline muted></video><div class="frame"></div></div><p id="hint" role="status">Coloca el QR en el recuadro.</p><form id="manual"><input id="manualCode" placeholder="Código de pase (opcional)"/><button>Validar</button></form><div id="result" hidden><h2 id="title"></h2><strong id="count"></strong><p id="family"></p><p id="detail"></p><button id="register" class="primary" hidden>Registrar entrada</button><button id="next" class="primary" hidden>Registrar siguiente entrada</button></div></dialog>
<script>import '../../scripts/event-access.ts';</script>
<style>
*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:#f5f3ef;color:#191919;font-family:system-ui,-apple-system,sans-serif;min-height:100dvh}header{height:74px;background:#171717;color:white;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:0 max(24px,calc((100vw - 1150px)/2));font-size:13px}header a{color:#eee;text-decoration:none;min-width:55px}.brand{display:flex;align-items:center;gap:10px;white-space:nowrap;letter-spacing:.1em;font-size:12px}.brand span{font:24px Georgia,serif;letter-spacing:-4px;border:1px solid #ffffff50;border-radius:9px;width:36px;height:36px;display:grid;place-items:center;padding-right:4px}header button{background:transparent;color:white;border:1px solid #ffffff50;min-height:39px;padding:8px 13px}main{max-width:1150px;margin:auto;padding:40px 24px 70px}.event-heading{margin-bottom:22px}.event-heading small{font-size:11px;font-weight:800;letter-spacing:.13em;color:#77716a}.folio{display:inline-block;background:#e6e2d9;color:#282621;border-radius:6px;padding:5px 8px;margin-left:5px}h1{font:500 clamp(37px,5vw,57px)/1.1 Georgia,serif;letter-spacing:-.04em;margin:15px 0 7px}h2{font-size:20px;margin:8px 0 10px}p{color:#68645e;line-height:1.55;font-size:14px}small{color:#77716a}button,input{font:inherit;border:1px solid #dcd8d0;border-radius:11px;padding:12px;background:#fff;color:#171717;min-height:46px}button{cursor:pointer;font-weight:700}button:disabled{opacity:.45;cursor:not-allowed}input{width:100%;min-width:0;outline:none}input:focus{border-color:#111;box-shadow:0 0 0 3px #1111}label,form{display:grid;gap:10px}label{font-weight:700;font-size:13px}.primary{background:#161616;color:white;font-weight:750;width:100%;min-height:54px;border:0}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:20px}.stats div{display:grid;gap:6px;padding:21px 22px;border:1px solid #e0dcd4;border-radius:16px;background:white;font-size:12px;color:#666;font-weight:650}.stats strong{font-size:35px;line-height:1.1;color:#171717;letter-spacing:-.06em}.stats div:nth-child(2) strong{color:#24734d}.workspace{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.55fr);gap:18px;align-items:start}.scan-card{background:#181818;color:white;border-radius:20px;padding:26px;min-height:245px;display:flex;flex-direction:column;align-items:flex-start}.scan-card p{color:#c4c3be;margin:0 0 20px}.scan-icon{width:62px;height:62px;display:grid;place-items:center;border-radius:16px;border:1px solid #ffffff40;background:#ffffff0b;margin-bottom:12px}.scan-card .primary{background:white;color:#151515;display:flex;align-items:center;justify-content:space-between;padding-inline:17px;margin-top:auto}.scan-card .primary span{font-size:25px}.guest-card{background:white;border:1px solid #e0dcd4;border-radius:20px;padding:25px}.guest-card small{font-size:10px;font-weight:750;letter-spacing:.08em}.guest-card h2{margin:5px 0 15px}.between{display:flex;align-items:center;justify-content:space-between;gap:10px}.guest-card #refresh{height:44px;width:44px;flex:none;padding:0;font-size:23px}.guest-card #search{background:#f7f6f2;margin-bottom:5px}.guest{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edeae4;padding:17px 0;gap:12px}.guest:last-child{border:0}.guest>div{min-width:0}.guest b{display:block;overflow-wrap:anywhere}.guest small{display:block;margin-top:5px;font-size:12px;letter-spacing:0;font-weight:500}.state{font-size:11px;font-weight:750;color:#756749;text-align:right;padding:7px 10px;background:#f6f0de;border-radius:30px;flex:none}.state.done{color:#24673f;background:#e7f3e9}.avatar{width:42px;height:42px;flex:none;background:#f0ede6;border-radius:13px;display:grid;place-items:center;font-weight:800;font-size:14px}.guest .guest-info{flex:1}#login{max-width:460px;background:white;border-radius:20px;border:1px solid #e0dcd4;padding:28px}#login p{margin-bottom:22px}#login small{display:block;margin-top:16px;font-size:12px}.lockmark{width:56px;height:56px;border-radius:15px;background:#eeece6;color:#333;display:grid;place-items:center;margin-bottom:18px}dialog{width:min(calc(100vw - 26px),480px);max-height:94dvh;overflow:auto;background:white;color:#171717;border:0;border-radius:22px;padding:20px;box-shadow:0 20px 80px #0006}dialog::backdrop{background:#121212b5;backdrop-filter:blur(4px)}dialog h2{margin:0}dialog #close{font-size:25px;width:44px;padding:3px;min-height:44px}#camera{position:relative;aspect-ratio:1;background:#252525;border-radius:16px;overflow:hidden;margin-top:14px}video{width:100%;height:100%;object-fit:cover}.frame{position:absolute;inset:17%;border:2px solid white;border-radius:14px;box-shadow:0 0 0 200px #0003;pointer-events:none}#manual{grid-template-columns:1fr auto}#manual input{font-size:13px}#result{text-align:center;border-radius:16px;padding:28px 16px;margin-top:12px;background:#f2f0ed}#result.allowed,#result.registered{background:#e5f3e9;color:#145a35}#result.denied,#result.used{background:#fbe8e5;color:#922b25}#result h2{font-size:17px;letter-spacing:.02em}#count{display:block;font-size:42px;letter-spacing:-.05em;margin:12px 0}#family{font-weight:750;font-size:19px}#result p{color:inherit}#result .primary{margin-top:12px}#hint{font-size:13px;margin:12px 0}
@media(max-width:700px){header{height:66px;padding:0 16px}.brand{font-size:10px;gap:7px}main{padding:26px 16px 45px}.event-heading{margin-bottom:18px}.stats{gap:8px;margin-bottom:14px}.stats div{padding:15px 10px;font-size:11px;border-radius:13px}.stats strong{font-size:29px}.workspace{grid-template-columns:1fr;gap:14px}.scan-card{min-height:0;padding:20px}.scan-card .scan-icon{width:44px;height:44px;border-radius:12px}.scan-card .scan-icon svg{width:26px;height:26px}.scan-card h2{margin:0 0 7px}.scan-card p{margin-bottom:17px}.guest-card{padding:18px 15px}.guest{gap:9px}.avatar{width:35px;height:35px;font-size:12px}#login{padding:23px}}
</style></body></html>