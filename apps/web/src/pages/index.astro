---
const brand = import.meta.env.PUBLIC_APP_NAME || 'CAZAMI Access';
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#151321"/><title>Inicio · {brand}</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f5f3ef;color:#171717;font-family:system-ui,-apple-system,sans-serif;min-height:100dvh}.wrap{max-width:1180px;padding:0 28px;margin:auto}nav{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dedbd5}.brand{display:flex;align-items:center;gap:12px;color:#111;text-decoration:none;font-size:13px;font-weight:850;letter-spacing:.12em}.brand:before{content:'CZ';font:27px Georgia,serif;letter-spacing:-5px;display:grid;place-items:center;width:47px;height:47px;background:#151515;color:white;border-radius:12px;padding-right:5px}.brand b{font-weight:450;color:#666}nav .menu{display:flex;gap:12px}nav .menu a{color:#555;text-decoration:none;font-size:13px;font-weight:650;padding:12px 10px}nav .menu a[aria-current]{color:#151515}main{min-height:calc(100dvh - 156px);display:grid;place-items:center;padding:44px 0}.hero{max-width:510px;width:100%}.eyebrow{font-size:11px;letter-spacing:.18em;font-weight:750;color:#68635c}h1{font:500 clamp(42px,7vw,66px)/1.04 Georgia,serif;letter-spacing:-.055em;margin:18px 0 14px}h1 em{font-style:normal}p{color:#68645e;font-size:15px;line-height:1.65;margin:0 0 25px}.entry{background:white;border:1px solid #e7e3dc;border-radius:22px;padding:26px;box-shadow:0 18px 65px #25221b0b}.entry label{display:block;font-size:12px;font-weight:800;margin-bottom:12px}.fields{display:grid;gap:12px}.fields input{width:100%;height:62px;padding:14px 18px;border:1px solid #d8d5cf;border-radius:12px;font:750 25px system-ui;letter-spacing:.09em;text-transform:uppercase;background:#faf9f6;outline:none;color:#171717}.fields input:focus{border-color:#111;box-shadow:0 0 0 3px #1111}.fields input::placeholder{color:#9a968f}.fields button{height:55px;border:0;border-radius:12px;background:#171717;color:white;font:750 15px system-ui;cursor:pointer}.fields button:disabled{opacity:.55}.entry small{display:block;color:#716d66;font-size:12px;line-height:1.5;margin-top:14px}.result{padding:15px 18px;margin-top:14px;border:1px solid #ead2cf;background:#fff1ef;border-radius:12px;color:#8b2c22;font-size:14px}.hidden{display:none}footer{font-size:11px;text-align:center;color:#77716a;border-top:1px solid #dedbd5;padding:24px 0}@media(max-width:600px){.wrap{padding:0 20px}nav{height:69px}.brand{font-size:10px;gap:9px}.brand:before{width:39px;height:39px;font-size:23px}nav .menu{gap:4px}nav .menu a{font-size:12px;padding:10px 7px}main{min-height:calc(100dvh - 140px);align-items:center;padding:32px 0}.entry{padding:21px}h1{font-size:49px}}
</style></head><body><div class="wrap"><nav><a href="/" class="brand">CAZAMI <b>ACCESS</b></a><div class="menu"><a href="/" aria-current="page">Inicio</a><a href="/admin">Admin</a></div></nav>
<main><section class="hero"><span class="eyebrow">ACCESO A EVENTOS</span><h1>Ingresa tu <em>código</em></h1><p>Ingresa el folio de la fiesta para abrir la lista de invitados y registrar las entradas.</p>
<form id="lookup" class="entry"><label for="code">Código del evento</label><div class="fields"><input id="code" type="text" maxlength="20" placeholder="CA-1" autocapitalize="characters" autocomplete="off" spellcheck="false" required/><button id="send" type="submit">Entrar a la fiesta</button></div><small>Ejemplo: CA-1 · Control de acceso para el personal del evento.</small></form><div id="result" class="result hidden" role="status" aria-live="polite"></div>
</section></main><footer>© {new Date().getFullYear()} CAZAMI Studio · Pases QR y control de acceso</footer></div>
<script>
const form=document.getElementById('lookup'),input=document.getElementById('code'),out=document.getElementById('result'),button=document.getElementById('send');
const escapeHtml=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function error(text){out.classList.remove('hidden');out.classList.add('error');out.textContent=text}
form.addEventListener('submit',async e=>{
 e.preventDefault();const folio=input.value.trim().toUpperCase();
 if(!/^CA-[1-9][0-9]{0,10}$/.test(folio)){error('Escribe un código válido, por ejemplo CA-1.');return}
 button.disabled=true;button.textContent='Buscando...';out.classList.add('hidden');out.classList.remove('error');
 try{
  const response=await fetch('/api/event/'+encodeURIComponent(folio),{cache:'no-store'});
  const data=await response.json();
  if(!response.ok)throw Error(data.error||'No se encontró el código.');
  window.location.assign('/event/'+encodeURIComponent(folio));
 }catch(e){error(e.message||'No se pudo consultar el evento.')}
 finally{button.disabled=false;button.textContent='Entrar a la fiesta'}
});
</script></body></html>